# Copy to .env (git-ignored). StudyTwin runs fully offline without any key (extractive answers,
# template questions); a Nebius Token Factory key enables the LLM features.
# Create a key at https://tokenfactory.nebius.com (OpenAI-compatible API).
NEBIUS_API_KEY=
# Alternatively point at another .env file that contains NEBIUS_API_KEY (only that key is read):
# STUDYTWIN_ENV_FILE=C:\path\to\other\.env

# Optional overrides (defaults shown)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# STUDYTWIN_OFFLINE=0                      # 1 = never call an LLM
# STUDYTWIN_MODEL_TUTOR=openai/gpt-oss-120b
# STUDYTWIN_MODEL_GENERATOR=deepseek-ai/DeepSeek-V4-Flash-0731
# STUDYTWIN_MODEL_VERIFIER=openai/gpt-oss-120b
# STUDYTWIN_MODEL_VISION=zai-org/GLM-5.3-Flash
# STUDYTWIN_MODEL_JUDGE=deepseek-ai/DeepSeek-V4-Flash-0731
# STUDYTWIN_EMBEDDER=BAAI/bge-small-en-v1.5   # "hash" = dependency-free embedder used by tests
# STUDYTWIN_WHISPER_MODEL=small
# STUDYTWIN_CONTEXT_BUDGET=1000            # evidence tokens after LLMSlim
# STUDYTWIN_TOP_K=8
# STUDYTWIN_USE_LLMSLIM=1
# STUDYTWIN_MIN_SUPPORT=0.55
